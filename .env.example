TAAPI_API_KEY=your_taapi_key_here  # From https://taapi.io
BITGET_API_KEY=your_bitget_api_key_here       # From https://www.bitget.com/account/newapi
BITGET_API_SECRET=your_bitget_api_secret_here  # From https://www.bitget.com/account/newapi
BITGET_PASSPHRASE=your_bitget_passphrase_here  # Passphrase set during API key creation
OPENROUTER_API_KEY=your_openrouter_key_here  # From https://openrouter.ai
ASSETS="BTC ETH SOL BNB"
INTERVAL="5m"
LLM_MODEL="x-ai/grok-4"
# Optional: BITGET_BASE_URL=https://api.bitget.com
# Optional: OPENROUTER_REFERER=https://your-site.com, OPENROUTER_APP_TITLE=trading-agent
